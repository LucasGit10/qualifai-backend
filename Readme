echo "    ]"
echo "  }'"
9. Verificar logs se houver problemas
bashCopy# Ver logs dos serviços
echo "📜 Para verificar logs:"
echo "Frontend: aws logs tail /ecs/${PROJECT_NAME:-sdr-virtual}-frontend --follow --region ${AWS_REGION:-us-east-1}"
echo "Backend: aws logs tail /ecs/${PROJECT_NAME:-sdr-virtual}-backend --follow --region ${AWS_REGION:-us-east-1}"
10. Salvar configuração final
bashCopy# Atualizar arquivo de configuração
cat >> infrastructure-ids.txt << EOF

# URLs finais
ALB_URL=http://qualifai-alb-604069372.us-east-1.elb.amazonaws.com
FRONTEND_URL=http://qualifai-alb-604069372.us-east-1.elb.amazonaws.com
API_URL=http://qualifai-alb-604069372.us-east-1.elb.amazonaws.com/api
WEBHOOK_URL=http://qualifai-alb-604069372.us-east-1.elb.amazonaws.com/api/webhooks/evolution
EOF

echo "✅ Configuração salva!"
Execute esses passos em ordem. Agora sua aplicação vai usar diretamente o ALB e deve funcionar perfeitamente! 🚀
